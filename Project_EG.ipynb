   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def haversine(lat1, lon1, lat2, lon2):\n",
    "    R = 6371\n",
    "    lat1 = radians(lat1)\n",
    "    lon1 = radians(lon1)\n",
    "    lat2 = radians(lat2)\n",
    "    lon2 = radians (lon2)\n",
    "\n",
    "    dlat = lat2 - lat1\n",
    "    dlon = lon2 - lon2\n",
    "\n",
    "    a = (\n",
    "    sin(dlat/2)**2\n",
    "    +cos(lat1)\n",
    "    +cos(lat2)\n",
    "    *sin(dlon/2)**2\n",
    "    )\n",
    "\n",
    "    c = 2* atan2 (\n",
    "    sqrt(a),\n",
    "    sqrt(1 - a)\n",
    "    )\n",
    "\n",
    "    return R*c"
   ]
  },
