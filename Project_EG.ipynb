   "source": [
    "medium_threshold = (\n",
    "    df[\"anomaly_score\"].quantile(0.90)\n",
    ")\n",
    "high_threshold = (\n",
    "    df[\"anomaly_score\"].quantile(0.99)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "dd0f9443-a46b-41e5-8edb-7a397100905d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def assign_risk(score):\n",
    "    if score >= high_threshold:\n",
    "        return \"High\"\n",
    "    elif score >= medium_threshold:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"Low\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "66e9ad49-76f9-448f-85ae-39a3ddd3803d",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"risk_lavel\"] = (\n",
    "    df[\"anomaly_score\"]\n",
    "    .apply(assign_risk)\n",
    ")"
   ]
  },
