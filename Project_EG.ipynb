   "source": [
    "df[\"trans_date_trans_time\"] = pd.to_datetime(df[\"trans_date_trans_time\"])\n",
    "df = df.sort_values(by=[\"cc_num\", \"trans_date_trans_time\"])\n",
    "\n",
    "df[\"Velocity_1H\"] = (\n",
    "        df.groupby(\"cc_num\")\n",
    "       .rolling(\"1h\", on = \"trans_date_trans_time\")[\"trans_num\"]\n",
    "        .count()\n",
    "        .values\n",
    ")\n",
    "\n",
    "\n",
    "def calculate_distance(row):\n",
    "    if row['zip'] == row['merch_zipcode']:\n",
    "        return 0.0  
    "    else:\n",
    "        return 50.0
  
    "df['Distance_From_Home'] = df.apply(calculate_distance, axis=1)\n",
    "\n",
    "\n",
    "#using contamination method\n",
    "\n",
    "\n",
    "# features = [\"amt\", \"Velocity_1H\", \"zip\"]\n",
    "# df[features] = df[features].fillna(0)\n",
    "\n",
    "# model = IsolationForest(contamination = 0.01, random_state=42)\n",
    "# model.fit(df[features])\n",
    "# predictions = model.predict(df[features])\n",
    "\n",
    "# df[\"Actual_fraud\"] = [1 if pred == -1 else 0 for  pred in predictions]\n",
    "\n",
    "# print(df[[\"cc_num\", \"amt\", \"Velocity_1H\", \"Actual_fraud\"]].head(10))\n",
    "\n",
    "\n",
    "#using z-scores method\n",
    "\n",
    "\n",
    "from scipy import stats\n",
    "df[\"amt_z_score\"] = np.abs(stats.zscore(df[\"amt\"]))\n",
    "df[\"Velocity_z_score\"] = np.abs(stats.zscore(df[\"Velocity_1H\"]))\n",
    "df[\"actual_fraud\"] = np.where((df[\"amt_z_score\"] > 3 ) | (df[\"Velocity_z_score\"] > 3 ), 1, 0)\n",
    "fraud_cases = df[df[\"actual_fraud\"] == 1 ]\n",
    "\n",
    "# print(f\"{len(fraud_cases)}\")\n",
    "print(fraud_cases[[\"cc_num\", \"amt\", \"Velocity_1H\", \"actual_fraud\", \"amt_z_score\",\"Velocity_z_score\"]].head(10))"
   ]
